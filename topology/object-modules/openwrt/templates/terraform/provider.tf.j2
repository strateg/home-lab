# Enforcer: {{ enforcer_id }}
# Scopes:   {{ scope_ids | join(', ') if scope_ids else 'none' }}

terraform {
  # 1.5 is the floor for `import` blocks, which is how stock sections are
  # adopted declaratively instead of by hand-running terraform import.
  required_version = ">= 1.5.0"

  required_providers {
    uapi = {
      source = "openwrt-iac/uapi"
      # The provider ships in lockstep with the uapi backend and its major.minor
      # must match what the router runs. Pinning the minor is deliberate: a
      # backend upgrade is an operator decision, not something a terraform init
      # should perform on its behalf.
      version = "~> 3.1"
    }
  }
}

provider "uapi" {
  endpoint = var.uapi_endpoint
  token    = var.uapi_token
  insecure = var.uapi_insecure
}
