# Generated by object.openwrt.generator.terraform - do not edit.
#
# Policy routing for {{ enforcer_id }} - the routing half of the two-mode
# design. The firewall half decides who MAY egress where; this decides which
# path their packets actually take, and the two are independent.
#
# Why policy routing is required rather than a plain default route: both modes
# have destination 0.0.0.0/0. A destination-based route cannot separate them -
# whichever won would capture both, so either the full-tunnel segment leaks to
# the venue or the split segment loses its direct internet. Only a source-based
# rule can, which is why each full-tunnel tunnel owns a routing table and each
# segment that egresses through it gets an ip-rule.
#
# Unlike the firewall, routing rules DO have ordering, and it is explicit here:
# `priority` is derived from the table number so the mapping is 1:1 and stable,
# and every value stays below the main-table lookup at 32766 - a rule at or
# after that would never match, because the destination is already resolved by
# then.
#
# A segment named by no tunnel gets no rule, falls through to the main table and
# egresses via the venue uplink. That is not an omission: it is what Slate-Split
# and Slate-Guest are for.

# ---------------------------------------------------------------------------
# Default route per tunnel, each in its own table
# ---------------------------------------------------------------------------
{% for route in policy_routes %}

{% if route.kind == 'prefix' %}
# Reached through {{ route.tunnel }}, in the MAIN table: every zone the firewall
# permits can use it, not only the segments whose default route that tunnel
# carries. This is the half `route_allowed_ips = false` removes - without it a
# split-mode client resolves against the main table and finds no path home.
{% endif %}
resource "uapi_network_route" "{{ route.label }}" {
  id        = "{{ route.id }}"
  target    = "{{ route.target }}"
  interface = uapi_network_interface.{{ route.interface_label }}.id
{% if route.table %}
  table     = {{ route.table }}
{% endif %}
{% if route.disabled %}

  # The tunnel is parked, so its route is too - rendered rather than omitted,
  # so enabling the tunnel stays a single topology change.
  disabled = true
{% else %}
  disabled = false
{% endif %}
}
{% endfor %}
{% if not policy_routes %}

# No tunnel carries a default route: every segment egresses via the main table.
{% endif %}

# ---------------------------------------------------------------------------
# Source rules selecting those tables
# ---------------------------------------------------------------------------
{% for rule in policy_rules %}

# {{ rule.segment }} -> {{ rule.tunnel }}
resource "uapi_network_rule" "{{ rule.label }}" {
  id       = "{{ rule.id }}"
  src      = "{{ rule.src }}"
  lookup   = {{ rule.lookup }}
  priority = {{ rule.priority }}
{% if rule.disabled %}
  disabled = true
{% else %}
  disabled = false
{% endif %}
}
{% endfor %}
{% if not policy_rules %}

# No source rule: nothing overrides the main table.
{% endif %}

# ---------------------------------------------------------------------------
# WireGuard peers
#
# `allowed_ips` is two things at once: the crypto-routing ACL - the far side may
# only source these prefixes, and WireGuard drops anything else before the
# firewall ever sees it - and, with `route_allowed_ips`, a route installer.
#
# That second role is why `route_allowed_ips` is FALSE on any tunnel carrying a
# default route. Letting netifd install 0.0.0.0/0 would put it in the MAIN
# table, capturing every segment including the split-mode one, and collapse the
# two-mode design into one without any error. The default route is installed
# deliberately instead, in the tunnel's own table, above.
#
# `public_key` and `endpoint_host` are variables, not values. A public key is
# not secret, but here it lives in SOPS beside the private one, and a VPS's
# public address is an operational value rather than topology. The same choice
# the MikroTik generator makes, for the same reason.
# ---------------------------------------------------------------------------
{% for peer in peers %}

# {{ peer.interface }} -> {{ peer.peer_device_ref }}  (keys: {{ peer.secrets_ref }})
resource "uapi_network_wireguard_peer" "{{ peer.label }}" {
  id         = "{{ peer.id }}"
  interface  = uapi_network_interface.{{ peer.interface_label }}.id
  public_key = var.{{ peer.label }}_public_key

  allowed_ips = [{% for cidr in peer.allowed_ips %}"{{ cidr }}"{{ ", " if not loop.last }}{% endfor %}]

  endpoint_host = var.{{ peer.label }}_endpoint_host
{% if peer.endpoint_port %}
  endpoint_port = {{ peer.endpoint_port }}
{% endif %}
{% if peer.persistent_keepalive %}

  # The road-warrior side must keep the mapping alive: it sits behind venue NAT
  # and the server cannot dial back in.
  persistent_keepalive = {{ peer.persistent_keepalive }}
{% endif %}
{% if peer.route_allowed_ips %}
  route_allowed_ips = true
{% else %}

  # False deliberately - see the note above this block. This tunnel's default
  # route is a uapi_network_route in its own table, above; it is not something
  # netifd derives from allowed_ips.
  route_allowed_ips = false
{% endif %}
  disabled = {{ "true" if peer.disabled else "false" }}
}
{% endfor %}
{% if not peers %}

# No WireGuard peer is configured on this device.
{% endif %}
