# Generated by object.openwrt.generator.terraform - do not edit.
#
# Firewall zone graph for {{ enforcer_id }}, lowered from the ADR 0110 security
# matrix. Two properties of firewall4 decide the shape of this file, and both
# invert what ADR 0110's RouterOS guidance would produce:
#
#   1. Zone chains are terminal and the nftables base chains carry `policy
#      drop`, so default-deny is structural. There is NO terminal drop-all rule
#      here and adding one would be wrong - appended into a zone chain it would
#      sit ahead of the forwardings it is meant to follow.
#
#   2. A denied matrix cell is lowered as the ABSENCE of a forwarding object.
#      {{ denied_pairs | length }} denial(s) are therefore represented by
#      nothing at all. They are listed at the end of this file as a comment so
#      the omissions are reviewable, and E9906 refuses any plan in which a
#      denied pair reappears as a forwarding.
#
# Rule ordering is not expressed anywhere because uapi exposes none: there is no
# position, index or place_before in its API. Permits are disjoint by
# construction instead, which E9902 enforces once rule sections exist.

{% for zone in zones %}
resource "uapi_firewall_zone" "{{ zone.label }}" {
  name = "{{ zone.name }}"

  # uapi_firewall_zone has no device or subnet field - only `network` - so each
  # member must be a real config interface section. An interface named in no
  # zone is silently unreachable rather than open (E9905).
  network = [{% for net in zone.networks %}"{{ net }}"{{ ", " if not loop.last }}{% endfor %}]

  # Declared explicitly, never inherited: stock OpenWrt ships the LAN zone with
  # input ACCEPT, which publishes SSH and the uapi endpoint to that zone's
  # clients (E9907).
  input         = "{{ zone.input }}"
  forward       = "{{ zone.forward }}"
  output_policy = "{{ zone.output }}"
{% if zone.masq is not none %}

  # Egress NAT, stated per (device, zone) in the matrix rather than inferred.
  # Until this was emitted, NAT for client egress depended on the STOCK wan
  # zone still being present, so removing the stock zones would have silently
  # killed internet for the split and guest segments.
  masq = {{ "true" if zone.masq else "false" }}
{% endif %}
{% if zone.mtu_fix is not none %}

  # Clamps TCP MSS to the route's MTU (`maxseg size set rt mtu`), so no number
  # is authored. This is what makes TCP shrink instead of stall where the
  # onward link is narrower than the client's segment - on the tunnel zone it
  # never existed, and W9902 named it as the mitigation while nothing emitted
  # it.
  mtu_fix = {{ "true" if zone.mtu_fix else "false" }}
{% endif %}
{% if zone.input_services %}

  # Services this zone needs on the input path: {{ zone.input_services | join(', ') }}
  # Rendered as explicit rules in a later slice; recorded here so the gap is
  # visible rather than silently missing.
{% endif %}
}

{% endfor %}
{% if forwardings %}
{% for fwd in forwardings %}
resource "uapi_firewall_forwarding" "{{ fwd.label }}" {
  src  = uapi_firewall_zone.{{ fwd.src_label }}.name
  dest = uapi_firewall_zone.{{ fwd.dest_label }}.name
}

{% endfor %}
{% else %}
# No inter-zone forwarding is permitted between two local zones.
{% endif %}
{% if deferred.remote_dest or deferred.port_scoped %}
# Permits not represented above:
{% if deferred.remote_dest %}
#   {{ deferred.remote_dest }} with a remote destination zone. These mean "may
#   reach a network behind a tunnel"; the renderable edge is the forwarding into
#   this device's tunnel zone, and routing selects which tunnel.
{% endif %}
{% if deferred.port_scoped %}
#   {{ deferred.port_scoped }} port-scoped. A forwarding is all-or-nothing
#   between zones, so these must become uapi_firewall_rule sections. Emitting a
#   forwarding instead would widen the grant to every port.
{% endif %}
{% endif %}

# Denied pairs, present as omissions:
{% for pair in denied_pairs %}
#   {{ pair.src }} -x> {{ pair.dest }}  [{{ pair.rule }}] {{ pair.reason }}
{% else %}
#   none
{% endfor %}
