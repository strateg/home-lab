# Declare reaches_zone_refs on the interface that reaches it; guessing one here
# would invent a route the compiler cannot see.
{% for item in unroutable_permits %}
#   {{ item.src }} -> {{ item.dest }}  (missing: {{ item.missing }})
{% endfor %}
