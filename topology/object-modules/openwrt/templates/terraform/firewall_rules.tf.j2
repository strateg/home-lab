#
# Rules for permits a forwarding cannot express: those scoped to ports, and
# those destined for a zone this device does not host. A forwarding is
# all-or-nothing between two zones, so rendering one for a port-scoped permit
# would grant every port; and a zone hosted elsewhere has no resource to point
# a forwarding at, so the permit becomes a rule leaving through the local zone
# that reaches it, restricted to that zone's prefixes.
#
# One rule per protocol. A match mixing protocols with different port sets would
# be a single wider grant than the matrix expressed, and separate tuples are
# what keeps them disjoint - which is the whole ordering contract here, since
# uapi exposes no position, index or place_before (E9902).
#
# Note the arity, which is not cosmetic: src_zone and dest_zone are strings
# while proto, dest_port and dest_ip are lists. A list where fw4 expects a
# scalar makes it drop the entire section without saying so (E9903).

{% for rule in rules %}
# {{ rule.rule }}: {{ rule.reason }}
{% if rule.remote_zone %}
# Destination zone {{ rule.remote_zone }} is hosted elsewhere; this leaves
# through {{ rule.dest_zone }} and is restricted to that zone's prefixes.
{% endif %}
resource "uapi_firewall_rule" "{{ rule.label }}" {
  name   = "{{ rule.name }}"
  target = "{{ rule.target }}"

  match = {
    src_zone  = uapi_firewall_zone.{{ rule.src_label }}.name
    dest_zone = uapi_firewall_zone.{{ rule.dest_label }}.name
    # Never defaulted by the provider: absent means IPv4 only, so it is stated.
    family    = "{{ rule.family }}"
{% if rule.proto %}
    proto     = [{% for item in rule.proto %}"{{ item }}"{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
{% if rule.dest_ip %}
    dest_ip   = [{% for item in rule.dest_ip %}"{{ item }}"{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
{% if rule.dest_port %}
    dest_port = [{% for item in rule.dest_port %}"{{ item }}"{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
