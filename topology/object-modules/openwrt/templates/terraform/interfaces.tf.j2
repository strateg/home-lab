# those attributes: the section is adopted and kept, never reconfigured from
# here. Changing the management address is an out-of-band operation.
{% elif iface.kind == 'wireguard' %}
# WireGuard interface. `private_key` is NOT rendered - it is a variable, so the
# key never enters a generated file or Terraform's plan output. Peers are a
