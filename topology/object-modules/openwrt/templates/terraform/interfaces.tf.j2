{% endif %}
{% if iface.ipaddrs %}

  # List, per the schema. `ipaddr` is read-only and must not be written.
  ipaddrs = [{% for addr in iface.ipaddrs %}"{{ addr }}"{{ ", " if not loop.last }}{% endfor %}]
{% if iface.netmask %}
  netmask = "{{ iface.netmask }}"
{% endif %}
