# the wifi-iface whose network is "{{ iface.id }}".
{% endif %}
resource "uapi_network_interface" "{{ iface.label }}" {
  id    = "{{ iface.id }}"
  proto = "{{ iface.proto }}"
{% if iface.device %}
  device = "{{ iface.device }}"
{% endif %}
