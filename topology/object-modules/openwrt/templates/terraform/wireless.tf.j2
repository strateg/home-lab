# Generated by object.openwrt.generator.terraform - do not edit.
#
# Radios and wifi-ifaces for {{ enforcer_id }}.
#
# Three things about this file are not stylistic:
#
#   1. `channel` is typed Number on uapi_wireless_device, so the string `auto`
#      is NOT renderable. netifd settles what to use instead: its
#      `_wdev_prepare_channel` matches `""|0|auto` and sets `auto_channel=1`, so
#      0 is an exact synonym and the only spelling this attribute can carry.
#      A station-bearing radio therefore reads `channel = 0` here.
#   2. `country` is mandatory wherever a 5 GHz AP lives. Regdomain 00 marks
#      every 5 GHz range NO-IR in wireless-regdb, so the AP never beacons and
#      the SSID simply does not exist (E9908).
#   3. `network` is a SCALAR string, not a list: one SSID, one network. The
#      string must name a config interface section that exists, or clients
#      associate onto nothing while hostapd reports success (E9912).
#
# `id` fixes each uci section name. For radios that matters twice over: the
# schema has no `path` attribute, so the section name is the radio's only
# identity, and it must match the stock section for adoption to bind to the
# intended phy.

# ---------------------------------------------------------------------------
# Radios
# ---------------------------------------------------------------------------
{% for radio in wireless_devices %}

resource "uapi_wireless_device" "{{ radio.label }}" {
  id   = "{{ radio.id }}"
  type = "{{ radio.type }}"
{% if radio.band %}
  band = "{{ radio.band }}"
{% endif %}
{% if radio.channel == 0 %}

  # 0 is auto, per netifd's `""|0|auto` case. This radio carries a station, and
  # a declared channel there is not honoured anyway: netifd passes an empty
  # frequency for mode=sta, so the phy follows whatever the station associates
  # to (W9904).
  channel = 0
{% else %}
  channel = {{ radio.channel }}
{% endif %}
{% if radio.htmode %}
  htmode = "{{ radio.htmode }}"
{% endif %}
{% if radio.country %}
  country = "{{ radio.country }}"
{% else %}

  # No country declared. If any AP on this radio is 5 GHz this is E9908.
{% endif %}
  disabled = {{ "true" if radio.disabled else "false" }}
}
{% endfor %}

# ---------------------------------------------------------------------------
# wifi-ifaces
#
# Created with explicit ids rather than adopted. uapi adopts a named section in
# place but adopts an anonymous one by renaming it to a ULID, which mutates the
# router (W9903).
#
# Measured on this device 2026-10-12, correcting an earlier assumption here:
# the stock wifi-ifaces are NAMED - `default_radio0` and `default_radio1` - and
# both ship `disabled '1'`. They therefore neither conflict with the ids below
# nor need removing before an apply; they are simply left unmanaged. The radios
# themselves ARE adopted, which is not optional: `wireless.radioN` carries a
# `path` option binding it to a phy, `uapi_wireless_device` does not expose
# `path`, and recreating a radio section would lose that binding.
# ---------------------------------------------------------------------------
{% for iface in wireless_interfaces %}

resource "uapi_wireless_interface" "{{ iface.label }}" {
  id     = "{{ iface.id }}"
  device = uapi_wireless_device.{{ iface.device_label }}.id
{% if iface.mode %}
  mode = "{{ iface.mode }}"
{% endif %}
{% if iface.ssid %}
  ssid = "{{ iface.ssid }}"
{% endif %}
{% if iface.encryption %}
  encryption = "{{ iface.encryption }}"

  # Write-only in the provider and never returned by the API, so it is a
  # variable: the passphrase does not enter a generated file.
  key = var.{{ iface.label }}_key
{% endif %}

  # Scalar, per the schema: one SSID, one network.
  network = uapi_network_interface.{{ iface.network_label }}.id
{% if iface.disabled %}

  # Parked deliberately - part of the SSID budget that bounds the ath11k
  # memory leak. Rendered disabled rather than omitted, so switching it on is a
  # topology change and not a hand-edit that never shows as drift.
  disabled = true
{% else %}
  disabled = false
{% endif %}
}
{% endfor %}
{% if ap_sharing_radio_with_station %}

# Note: {{ ap_sharing_radio_with_station | join(', ') }} share a radio with a
# station. Any sta interface on a phy sets ap_start_disabled, so hostapd gets
# start_disabled=1 and those APs do not beacon until the station associates;
# wpa_supplicant then stops them on every DISCONNECTED/SCANNING transition,
# deauthing their clients on each scan or roam (W9901).
{% endif %}
