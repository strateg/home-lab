# Generated by object.openwrt.generator.terraform - do not edit.

variable "uapi_endpoint" {
  type        = string
  description = "uapi base URL including the API version path, e.g. https://192.168.1.1/api/v3"
}

variable "uapi_token" {
  type        = string
  sensitive   = true
  description = <<-EOT
    Bearer token minted on the router with `uapi-token create`. Lives in
    projects/home-lab/secrets/instances/rtr-slate.yaml under SOPS; it is never
    committed in plaintext and never defaulted here.
  EOT
}

variable "uapi_insecure" {
  type        = bool
  default     = true
  description = <<-EOT
    Skip TLS verification. Defaults true because the router serves a
    self-signed certificate on the management path, and the token is itself
    source-IP scoped. Set false once a trusted certificate is in place.
  EOT
}
{% if secret_variables %}

# ---------------------------------------------------------------------------
# Per-resource secrets.
#
# Declared without defaults and marked sensitive, so a value never enters a
# generated file and never appears in plan output. WireGuard private keys and
# wireless passphrases are both write-only in the provider - the API does not
# return them - so Terraform cannot detect drift on either, and a changed value
# is only applied when the variable changes.
# ---------------------------------------------------------------------------
{% for secret in secret_variables %}

variable "{{ secret.name }}" {
  type        = string
  sensitive   = true
  description = "{{ secret.description }}"
}
{% endfor %}
{% endif %}
