# MikroTik Container Resources
# Generated from topology - DO NOT EDIT MANUALLY
#
# This file manages containers on RouterOS 7.x devices, including:
# - Container registry configuration
# - WireGuard key generation (for AWG proxy containers)
# - Virtual ethernet (veth) interfaces for container networking
# - WireGuard interfaces connecting to containers
# - Container definitions with images and configuration
# - Environment variables (including secrets from Terraform variables)

{% set managed_containers = containers | selectattr('veth_name') | list %}
{% if managed_containers %}
# =============================================================================
# Container Registry Configuration
# =============================================================================

resource "routeros_container_config" "main" {
  registry_url = "https://ghcr.io"
  tmpdir       = "/usb1/containers/tmp"
  ram_high     = 0  # Unlimited
}

{% for container in managed_containers %}
# =============================================================================
# Container Bundle: {{ container.name }}
# Instance: {{ container.instance_id }}
# =============================================================================

{% if container.wireguard_interface %}
# --- WireGuard Key Generation ---
# Keys are generated by Terraform, then should be exported to SOPS for storage
resource "wireguard_asymmetric_key" "{{ container.tf_name }}" {}

{% endif %}
# --- Veth Interface ---
resource "routeros_interface_veth" "{{ container.tf_name }}" {
  name    = "{{ container.veth_name }}"
  address = ["{{ container.veth_address }}"]
  gateway = "{{ container.veth_gateway }}"
  comment = "{{ container.name }} veth - managed by Terraform"
}

{% if container.wireguard_interface %}
# --- WireGuard Interface: {{ container.wireguard_interface.name }} ---
resource "routeros_interface_wireguard" "{{ container.tf_name }}_wg" {
  name        = "{{ container.wireguard_interface.name }}"
  listen_port = {{ container.wireguard_interface.listen_port }}
  mtu         = {{ container.wireguard_interface.mtu }}
  # Use generated key or override with var (for SOPS migration)
  private_key = coalesce(var.{{ container.wireguard_interface.private_key_var }}, wireguard_asymmetric_key.{{ container.tf_name }}.private_key)
  comment     = "WireGuard for {{ container.name }} - managed by Terraform"
}

# WireGuard IP Address
resource "routeros_ip_address" "{{ container.tf_name }}_wg" {
  address   = "{{ container.wireguard_interface.address }}"
  interface = routeros_interface_wireguard.{{ container.tf_name }}_wg.name
  comment   = "{{ container.wireguard_interface.name }} tunnel IP - managed by Terraform"

  lifecycle {
    # RouterOS API returns vrf field that can't be patched
    ignore_changes = [vrf]
  }
}

# WireGuard Interface List Membership
resource "routeros_interface_list_member" "{{ container.tf_name }}_wg" {
  interface = routeros_interface_wireguard.{{ container.tf_name }}_wg.name
  list      = "{{ container.wireguard_interface.interface_list }}"
  comment   = "{{ container.wireguard_interface.name }} in {{ container.wireguard_interface.interface_list }} - managed by Terraform"
}

# WireGuard Peer (AWG server via container)
resource "routeros_interface_wireguard_peer" "{{ container.tf_name }}_wg" {
  interface            = routeros_interface_wireguard.{{ container.tf_name }}_wg.name
  public_key           = var.{{ container.wireguard_interface.peer.public_key_var }}
{% if container.wireguard_interface.peer.preshared_key_ref %}
  preshared_key        = var.{{ container.wireguard_interface.peer.preshared_key_var }}
{% endif %}
  # Endpoint is the container's veth address
  endpoint_address     = "{{ container.wireguard_interface.peer.endpoint_address }}"
  endpoint_port        = {{ container.wireguard_interface.peer.endpoint_port }}
  allowed_address      = {{ container.wireguard_interface.peer.allowed_ips | tojson }}
  persistent_keepalive = "{{ container.wireguard_interface.peer.persistent_keepalive }}s"
  comment              = "AWG server via {{ container.name }} - managed by Terraform"
}

{% endif %}
# --- Container: {{ container.name }} ---
resource "routeros_container" "{{ container.tf_name }}" {
  remote_image  = "{{ container.image }}"
  interface     = routeros_interface_veth.{{ container.tf_name }}.name
{% if container.root_dir %}
  root_dir      = "{{ container.root_dir }}"
{% endif %}
  start_on_boot = {{ container.start_on_boot | lower }}
  logging       = {{ container.logging | lower }}
  envlist       = "{{ container.name }}"
  comment       = "{{ container.comment }}"

  depends_on = [
    routeros_container_config.main,
    routeros_interface_veth.{{ container.tf_name }}{% if container.wireguard_interface %},
    routeros_interface_wireguard.{{ container.tf_name }}_wg,
    routeros_interface_wireguard_peer.{{ container.tf_name }}_wg{% endif %}

  ]

  lifecycle {
    # MikroTik strips registry prefix from image name, causing constant diff
    ignore_changes = [remote_image]
  }
}

# --- Environment Variables ---
{% for env in container.envs %}
resource "routeros_container_envs" "{{ container.tf_name }}_{{ env.key | lower }}" {
  name  = "{{ container.name }}"
  key   = "{{ env.key }}"
{% if env.is_secret %}
  value = var.{{ env.var_name }}
{% else %}
  value = "{{ env.value }}"
{% endif %}
}

{% endfor %}
{% endfor %}
# =============================================================================
# Outputs: Generated WireGuard Keys (export to SOPS)
# =============================================================================
{% for container in managed_containers %}
{% if container.wireguard_interface %}

output "{{ container.tf_name }}_wg_private_key" {
  description = "WireGuard private key for {{ container.name }} - SAVE TO SOPS"
  value       = wireguard_asymmetric_key.{{ container.tf_name }}.private_key
  sensitive   = true
}

output "{{ container.tf_name }}_wg_public_key" {
  description = "WireGuard public key for {{ container.name }}"
  value       = wireguard_asymmetric_key.{{ container.tf_name }}.public_key
}
{% endif %}
{% endfor %}
{% else %}
# No containers with dedicated veth networks defined in topology
{% endif %}
