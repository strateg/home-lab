# MikroTik WireGuard VPN configuration
# Generated from topology - DO NOT EDIT MANUALLY

{% if has_wireguard %}
{% if wireguard_interfaces %}
# ==============================================================================
# Multi-interface WireGuard configuration
# ==============================================================================
{% for iface in wireguard_interfaces %}

# WireGuard Interface: {{ iface.name }}
resource "routeros_interface_wireguard" "{{ iface.name }}" {
  name        = "{{ iface.name }}"
  listen_port = {{ iface.listen_port if iface.listen_port else (51820 + loop.index0) }}
  private_key = var.wireguard_{{ iface.name }}_private_key
  mtu         = {{ iface.mtu if iface.mtu else 1420 }}
  comment     = "WireGuard {{ iface.name }} - managed by topology"
}

# IP Address for {{ iface.name }}
{% if iface.address %}
resource "routeros_ip_address" "{{ iface.name }}" {
  address   = "{{ iface.address }}"
  interface = routeros_interface_wireguard.{{ iface.name }}.name
  comment   = "WireGuard {{ iface.name }} IP - managed by topology"
}
{% endif %}

# Add {{ iface.name }} to {{ iface.interface_list | default('LAN') }} interface list
resource "routeros_interface_list_member" "{{ iface.name }}_{{ iface.interface_list | default('LAN') | lower | replace('_', '') }}" {
  interface = routeros_interface_wireguard.{{ iface.name }}.name
  list      = "{{ iface.interface_list | default('LAN') }}"
  comment   = "WireGuard {{ iface.name }} in {{ iface.interface_list | default('LAN') }} - managed by topology"
}

# Peers for {{ iface.name }}
{% for peer in iface.peers %}
resource "routeros_interface_wireguard_peer" "{{ iface.name }}_{{ peer.name | replace('-', '_') | replace('.', '_') }}" {
  count                = length(var.wireguard_{{ iface.name }}_peers) > {{ loop.index0 }} ? 1 : 0
  interface            = routeros_interface_wireguard.{{ iface.name }}.name
  public_key           = length(var.wireguard_{{ iface.name }}_peers) > {{ loop.index0 }} ? var.wireguard_{{ iface.name }}_peers[{{ loop.index0 }}].public_key : ""
  preshared_key        = length(var.wireguard_{{ iface.name }}_peers) > {{ loop.index0 }} ? var.wireguard_{{ iface.name }}_peers[{{ loop.index0 }}].preshared_key : null
  endpoint_address     = length(var.wireguard_{{ iface.name }}_peers) > {{ loop.index0 }} ? var.wireguard_{{ iface.name }}_peers[{{ loop.index0 }}].endpoint_address : null
  endpoint_port        = length(var.wireguard_{{ iface.name }}_peers) > {{ loop.index0 }} ? var.wireguard_{{ iface.name }}_peers[{{ loop.index0 }}].endpoint_port : null
  allowed_address      = length(var.wireguard_{{ iface.name }}_peers) > {{ loop.index0 }} ? var.wireguard_{{ iface.name }}_peers[{{ loop.index0 }}].allowed_ips : []
  persistent_keepalive = length(var.wireguard_{{ iface.name }}_peers) > {{ loop.index0 }} ? var.wireguard_{{ iface.name }}_peers[{{ loop.index0 }}].persistent_keepalive : null
  comment              = {{ peer.comment | default("Remote: " + peer.name) | tojson }}
}

{% endfor %}
{% endfor %}
{% else %}
# ==============================================================================
# Legacy single-interface WireGuard configuration (wg0)
# ==============================================================================

locals {
  wireguard_interface_name = "wg0"
}

# WireGuard Interface
resource "routeros_interface_wireguard" "wg0" {
  name        = local.wireguard_interface_name
  listen_port = {{ wireguard_listen_port | default(51820) }}
  private_key = var.wireguard_private_key
  mtu         = {{ wireguard_mtu | default(1420) }}
  comment     = "WireGuard tunnel - managed by topology"
}

# WireGuard Peers
{% for peer in wireguard_peers %}
resource "routeros_interface_wireguard_peer" "{{ peer.name | replace('-', '_') }}" {
  count                = length(var.wireguard_peers) > {{ loop.index0 }} ? 1 : 0
  interface            = routeros_interface_wireguard.wg0.name
  public_key           = length(var.wireguard_peers) > {{ loop.index0 }} ? var.wireguard_peers[{{ loop.index0 }}].public_key : ""
  preshared_key        = length(var.wireguard_peers) > {{ loop.index0 }} ? var.wireguard_peers[{{ loop.index0 }}].preshared_key : null
  endpoint_address     = length(var.wireguard_peers) > {{ loop.index0 }} ? var.wireguard_peers[{{ loop.index0 }}].endpoint_address : null
  endpoint_port        = length(var.wireguard_peers) > {{ loop.index0 }} ? var.wireguard_peers[{{ loop.index0 }}].endpoint_port : null
  allowed_address      = length(var.wireguard_peers) > {{ loop.index0 }} ? var.wireguard_peers[{{ loop.index0 }}].allowed_ips : []
  persistent_keepalive = length(var.wireguard_peers) > {{ loop.index0 }} ? var.wireguard_peers[{{ loop.index0 }}].persistent_keepalive : null
  comment              = {{ peer.comment | default("Remote: " + peer.name) | tojson }}
}

{% endfor %}
# WireGuard Interface IP Address
resource "routeros_ip_address" "wg0" {
  address   = "{{ wireguard_address | default('10.100.0.1/30') }}"
  interface = routeros_interface_wireguard.wg0.name
  comment   = "WireGuard tunnel IP - managed by topology"
}

# Add WireGuard to LAN interface list (firewall trust)
resource "routeros_interface_list_member" "wg0_lan" {
  interface = routeros_interface_wireguard.wg0.name
  list      = "LAN"
  comment   = "Trust WireGuard tunnel - managed by topology"
}
{% endif %}
{% for policy in routing_policies %}
{% if policy.enabled and not policy.staged %}

# ==============================================================================
# Policy-based routing: {{ policy.instance_id }}
# {{ policy.policy_name }} ({{ policy.source_subnet }} -> {{ policy.tunnel_interface }})
# ==============================================================================
{% if policy.routing_table and policy.routing_table.name %}
resource "routeros_routing_table" "{{ policy.name }}" {
  name = "{{ policy.routing_table.name }}"
  fib  = {{ 'true' if policy.routing_table.get('fib', True) else 'false' }}
  comment = "{{ policy.policy_name }} routing table - managed by topology"
}
{% endif %}
{% for rule in policy.mangle_rules %}

resource "routeros_ip_firewall_mangle" "{{ policy.name }}_mangle_{{ loop.index }}" {
  chain  = "{{ rule.chain }}"
  action = "{{ rule.action }}"
{% if rule.get('src_address') %}
  src_address = "{{ rule.get('src_address') }}"
{% endif %}
{% if rule.get('dst_address') %}
  dst_address = "{{ rule.get('dst_address') }}"
{% endif %}
{% if rule.get('connection_mark') %}
  connection_mark = "{{ rule.get('connection_mark') }}"
{% endif %}
{% if rule.get('new_connection_mark') %}
  new_connection_mark = "{{ rule.get('new_connection_mark') }}"
{% endif %}
{% if rule.get('new_routing_mark') %}
  new_routing_mark = "{{ rule.get('new_routing_mark') }}"
{% endif %}
  passthrough = {{ 'true' if rule.get('passthrough', True) else 'false' }}
  comment     = "{{ policy.policy_name }} mangle - managed by topology"
{% if loop.index > 1 %}
  depends_on = [routeros_ip_firewall_mangle.{{ policy.name }}_mangle_{{ loop.index - 1 }}]
{% elif policy.routing_table and policy.routing_table.name %}
  depends_on = [routeros_routing_table.{{ policy.name }}]
{% endif %}
}
{% endfor %}
{% for route in policy.routes %}

resource "routeros_ip_route" "{{ policy.name }}_route_{{ loop.index }}" {
  dst_address   = "{{ route.dst_address }}"
  gateway       = "{{ route.gateway }}"
{% if route.get('routing_table') %}
  routing_table = "{{ route.get('routing_table') }}"
{% endif %}
  comment       = "{{ policy.policy_name }} route - managed by topology"
{% if policy.routing_table and policy.routing_table.name %}
  depends_on = [routeros_routing_table.{{ policy.name }}]
{% endif %}
}
{% endfor %}
{% for nat in policy.nat_rules %}

resource "routeros_ip_firewall_nat" "{{ policy.name }}_nat_{{ loop.index }}" {
  chain  = "{{ nat.chain }}"
  action = "{{ nat.action }}"
{% if nat.get('src_address') %}
  src_address = "{{ nat.src_address }}"
{% endif %}
{% if nat.get('out_interface') %}
  out_interface = "{{ nat.out_interface }}"
{% endif %}
{% if nat.get('out_interface_list') %}
  out_interface_list = "{{ nat.out_interface_list }}"
{% endif %}
  comment = "{{ nat.get('comment', policy.policy_name + ' NAT') }} - managed by topology"
}
{% endfor %}
{% if policy.mss_clamp %}

# MSS clamping for tunnel MTU issues
resource "routeros_ip_firewall_mangle" "{{ policy.name }}_mss_clamp" {
  chain            = "{{ policy.mss_clamp.get('chain', 'forward') }}"
  action           = "change-mss"
  protocol         = "tcp"
  tcp_flags        = "syn"
{% if policy.mss_clamp.get('out_interface') %}
  out_interface    = "{{ policy.mss_clamp.get('out_interface') }}"
{% endif %}
{% if policy.mss_clamp.get('in_interface') %}
  in_interface     = "{{ policy.mss_clamp.get('in_interface') }}"
{% endif %}
  new_mss          = {{ policy.mss_clamp.get('new_mss') }}
  passthrough      = true
  comment          = "{{ policy.policy_name }} MSS clamp - managed by topology"
}
{% endif %}
{% if policy.fasttrack %}

# Fasttrack for established VPN connections (performance optimization)
resource "routeros_ip_firewall_filter" "{{ policy.name }}_fasttrack" {
  chain            = "forward"
  action           = "fasttrack-connection"
  connection_mark  = "{{ policy.fasttrack.get('connection_mark', policy.name) }}"
  connection_state = "established,related"
  comment          = "{{ policy.fasttrack.get('comment', policy.policy_name + ' fasttrack') }} - managed by topology"
}

resource "routeros_ip_firewall_filter" "{{ policy.name }}_fasttrack_accept" {
  chain            = "forward"
  action           = "accept"
  connection_mark  = "{{ policy.fasttrack.get('connection_mark', policy.name) }}"
  connection_state = "established,related"
  comment          = "{{ policy.fasttrack.get('comment', policy.policy_name + ' fasttrack') }} accept - managed by topology"
}
{% endif %}
{% for rule in policy.notrack %}

# Notrack rule for WireGuard performance
resource "routeros_ip_firewall_raw" "{{ policy.name }}_notrack_{{ loop.index }}" {
  chain    = "{{ rule.get('chain', 'prerouting') }}"
  action   = "notrack"
  protocol = "{{ rule.get('protocol', 'udp') }}"
{% if rule.get('dst_port') %}
  dst_port = "{{ rule.get('dst_port') }}"
{% endif %}
{% if rule.get('src_port') %}
  src_port = "{{ rule.get('src_port') }}"
{% endif %}
{% if rule.get('src_address') %}
  src_address = "{{ rule.get('src_address') }}"
{% endif %}
{% if rule.get('dst_address') %}
  dst_address = "{{ rule.get('dst_address') }}"
{% endif %}
  comment  = "{{ rule.get('comment', policy.policy_name + ' notrack') }} - managed by topology"
}
{% endfor %}
{% if has_security_matrix %}

# Tunnel egress: allow new connections from {{ policy.source_subnet }} out via {{ policy.tunnel_interface }}.
# The zone firewall (ADR 0110) ends the forward chain with a final drop-all,
# so without this rule marked traffic is routed into the tunnel but dropped.
# place_before keeps this rule ahead of the final drop-all on the router.
resource "routeros_ip_firewall_filter" "{{ policy.name }}_tunnel_egress" {
  chain         = "forward"
  action        = "accept"
  src_address   = "{{ policy.source_subnet }}"
  out_interface = "{{ policy.tunnel_interface }}"
  comment       = "{{ policy.policy_name }} tunnel egress - managed by topology"
  place_before  = routeros_ip_firewall_filter.zone_drop_all_forward.id

  depends_on = [
    routeros_interface_wireguard.wg0,
    routeros_ip_firewall_filter.zone_drop_all_forward
  ]
}
{% endif %}
{% for rule in policy.get('firewall_rules', []) %}

# Container/tunnel WAN egress rule
resource "routeros_ip_firewall_filter" "{{ policy.name }}_fw_{{ loop.index }}" {
  chain         = "{{ rule.get('chain', 'forward') }}"
  action        = "{{ rule.get('action', 'accept') }}"
{% if rule.get('in_interface') %}
  in_interface  = "{{ rule.in_interface }}"
{% endif %}
{% if rule.get('out_interface') %}
  out_interface = "{{ rule.out_interface }}"
{% endif %}
{% if rule.get('src_address') %}
  src_address   = "{{ rule.src_address }}"
{% endif %}
{% if rule.get('dst_address') %}
  dst_address   = "{{ rule.dst_address }}"
{% endif %}
  comment       = "{{ rule.get('comment', policy.policy_name + ' firewall rule') }} - managed by topology"
{% if has_security_matrix %}
  place_before  = routeros_ip_firewall_filter.zone_drop_all_forward.id

  depends_on = [routeros_ip_firewall_filter.zone_drop_all_forward]
{% endif %}
}
{% endfor %}
{% endif %}
{% endfor %}
{% else %}
# WireGuard capability not enabled - no resources generated
{% endif %}
