# Keyring of networks rtr-slate's station uplink can join.
#
# Copy to venues.yaml and encrypt:
#   sops --config ../.sops.yaml -e venues.yaml.example > venues.yaml
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE IS, AND WHAT IT CANNOT BE
#
# It is a keyring: credentials for networks the device is allowed to join. It
# is NOT a candidate list the device works through, because the device cannot
# hold one. A `wifi-iface` carries exactly one SSID, and a second station on
# the same radio violates the phy's '#{ managed } <= 1' - that is E9910, not a
# style rule. `travelmate` is the package that manages a candidate list and it
# was rejected during the wireless research (report section W7).
#
# So: this file stores many, the device is told one, and `active` below is the
# one it is told. Changing venue is an edit to `active` plus an apply.
#
# ---------------------------------------------------------------------------
# WHICH RADIO THIS CONCERNS
#
#   radio1 (2.4 GHz)  the STATION - the uplink this file feeds
#   radio0 (5 GHz)    the ACCESS POINTS - Slate-Home, Slate-Split and the
#                     parked country SSIDs, whose passphrases live in
#                     secrets/terraform/openwrt.yaml, not here
#
# The split is deliberate and asymmetric: radio0 carries no station, so its
# APs do not stop beaconing when the uplink scans or roams. Any station on a
# phy sets ap_start_disabled, which would take every AP on that phy down on
# each DISCONNECTED/SCANNING transition (W9901). Keeping the station on radio1
# is what buys the APs their stability.
#
# ---------------------------------------------------------------------------
# WHY THE SELECTION LIVES HERE AND NOT IN TOPOLOGY
#
# A venue is not topology. Writing a hotel into an instance file would make
# every change of location a topology edit plus a commit, and would record as a
# durable fact something true for one week. The instance states only the stable
# fact - `credentials: operator_supplied` on the uplink - and the value comes
# from here.
#
# `active` is recorded rather than passed only at the command line so that
# `terraform plan` is deterministic: a selection that existed solely as an
# invocation argument would make the next plan propose changing the SSID back.
# ---------------------------------------------------------------------------
---
# Which venue the uplink currently joins. Must name a key under `venues`.
active: "mobile-hotspot"

venues:
  # A plain venue: everything it needs lives here.
  mobile-hotspot:
    ssid: "8d9d6e"
    # As reported by a scan, not assumed: "WPA PSK (CCMP)" -> psk2.
    # A venue may also be `none` (open) or `sae`; it is not knowable in
    # advance, which is why encryption is part of the credential and not
    # authored in topology.
    encryption: "psk2"
    passphrase: "the-venue-password"
    notes: "Phone hotspot, used to rehearse the travel path on 2026-10-13."

  # A venue whose credential already has an authoritative home. Pointed at
  # rather than copied: two copies of one passphrase means two places to
  # rotate, and one of them will be missed. The pointer is
  # <file relative to the secrets root>#<dotted path>.
  home:
    ssid: "Chateau"
    encryption: "sae-mixed"
    passphrase_from: "terraform/mikrotik.yaml#wifi.main_passphrase"
    notes: "The home AP. Useful when the device is at home but not cabled."

  # An open network needs an explicit empty passphrase, not an absent one:
  # absent means "nobody filled this in", empty means "there is none".
  # example-open:
  #   ssid: "Hotel Guest"
  #   encryption: "none"
  #   passphrase: ""
