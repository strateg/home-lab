# WireGuard Configuration for {{ client.device_ref }}
# Tunnel: {{ tunnel.instance_id }}
{% if profile %}
# Profile: {{ profile.get('name', 'default') }} - {{ profile.get('description', '') }}
{% if profile.get('exit_country') %}
# Exit Country: {{ profile.get('exit_country') }}
{% endif %}
{% if profile.get('exit_mode') %}
# Exit Mode: {{ profile.get('exit_mode') }}
{% endif %}
{% endif %}
# Generated from topology - DO NOT EDIT MANUALLY
#
# Deploy - import this file into the WireGuard client on the target device:
#   Sailfish OS: Settings -> VPN -> WireGuard -> + (Add) -> Import from file
#   GL.iNet:     VPN -> WireGuard Client -> Add Manually / Import Config
#   Linux:       /etc/wireguard/{{ tunnel_name }}.conf (chmod 600), then
#                systemctl enable --now wg-quick@{{ tunnel_name }}
#
{% if profile and profile.get('exit_mode') == 'chained' %}
# NOTE: This profile uses chained routing (VPS -> Home router -> ISP).
# Traffic from this tunnel IP is routed via wg1 on VPS using policy routing.
#
{% endif %}
# Routing is defined by AllowedIPs below.
{% if client.get('gateway_for') %}
#
# Gateway peer - these devices reach the tunnel through it and need no VPN
# config of their own (requires LAN -> {{ tunnel_name }} masquerade):
{% for dev in client.gateway_for %}
#   - {{ dev }}
{% endfor %}
{% endif %}

[Interface]
# {{ client.device_ref }} (road-warrior)
{% if profile and profile.get('tunnel_ip') %}
Address = {{ profile.get('tunnel_ip') }}
{% else %}
Address = {{ client.tunnel_ip }}
{% endif %}
PrivateKey = {{ client_keys.private_key }}
{% if profile and profile.get('dns') %}
DNS = {{ profile.get('dns') }}
{% elif client.get('dns') %}
DNS = {{ client.dns }}
{% endif %}
MTU = {{ mtu }}
{% if profile and profile.get('preserve_endpoint_route') %}

# Preserve route to VPS endpoint when on same network as exit node
# This prevents routing loop when AllowedIPs=0.0.0.0/0 captures endpoint traffic
PreUp = GATEWAY=$(ip route | grep default | head -1 | awk '{print $3}') && ip route add {{ server.public_endpoint }}/32 via $GATEWAY || true
PostDown = ip route del {{ server.public_endpoint }}/32 || true
{% endif %}
{% if profile and profile.get('block_dns_leaks') %}

# Kill switch + DNS leak protection - block ALL traffic outside tunnel
# Allow only: loopback, tunnel interface, and WireGuard endpoint
PostUp = iptables -I OUTPUT -o lo -j ACCEPT 2>/dev/null || true
PostUp = iptables -I OUTPUT -o %i -j ACCEPT 2>/dev/null || true
PostUp = iptables -I OUTPUT -d {{ server.public_endpoint }} -p udp --dport {{ server.listen_port | default(51820) }} -j ACCEPT 2>/dev/null || true
PostUp = iptables -A OUTPUT -j REJECT 2>/dev/null || true
# Force DNS through tunnel
PostUp = resolvectl dns %i 1.1.1.1 1.0.0.1 2>/dev/null || true
PostUp = resolvectl default-route %i true 2>/dev/null || true
# Cleanup on disconnect
PostDown = iptables -D OUTPUT -o lo -j ACCEPT 2>/dev/null || true
PostDown = iptables -D OUTPUT -o %i -j ACCEPT 2>/dev/null || true
PostDown = iptables -D OUTPUT -d {{ server.public_endpoint }} -p udp --dport {{ server.listen_port | default(51820) }} -j ACCEPT 2>/dev/null || true
PostDown = iptables -D OUTPUT -j REJECT 2>/dev/null || true
{% endif %}

[Peer]
# VPS Hub: {{ server.device_ref }}
PublicKey = {{ vps_keys.public_key }}
{% if client_keys.preshared_key %}
PresharedKey = {{ client_keys.preshared_key }}
{% endif %}
Endpoint = {{ server.public_endpoint }}:{{ server.listen_port | default(51820) }}
{% if profile and profile.get('routes') %}
AllowedIPs = {{ profile.get('routes') | join(', ') }}
{% else %}
AllowedIPs = {{ client.routes | join(', ') }}
{% endif %}
PersistentKeepalive = {{ client.persistent_keepalive | default(25) }}
